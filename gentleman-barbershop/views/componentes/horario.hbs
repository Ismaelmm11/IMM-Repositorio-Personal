<!-- FullCalendar -->
<link href="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.5/main.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.5/main.min.js"></script>

<style>
  #calendar {
    max-width: 1100px;
    margin: 20px auto;
  }

  .fc-event {
    cursor: pointer;
    font-size: 12px;
    border-radius: 4px;
    padding: 2px 4px;
    box-sizing: border-box;
  }

  .fc-timegrid-event-harness {
    position: relative !important;
  }

  .fc-timegrid-event {
    position: absolute !important;
    box-sizing: border-box;
    padding: 2px;
    border-radius: 4px;
    font-size: 12px;
    overflow: hidden;
  }

  button {
    margin: 5px;
    padding: 6px 12px;
    background-color: #007bff;
    border: none;
    color: white;
    border-radius: 4px;
    cursor: pointer;
  }

  button:hover {
    background-color: #0056b3;
  }

  .fc-toolbar-title {
    font-size: 1.25rem;
  }

  #form-modal {
    display: none;
    position: fixed;
    top: 10%;
    left: 20%;
    width: 60%;
    background: white;
    border: 1px solid #ccc;
    padding: 20px;
    z-index: 9999;
    box-shadow: 0 0 10px rgba(0,0,0,0.3);
    border-radius: 8px;
  }

  .delete-button {
    background-color: #dc3545;
  }

  .delete-button:hover {
    background-color: #c82333;
  }
</style>

<div>
  <button onclick="cambiarDia('anterior')">← Día Anterior</button>
  <button onclick="cambiarDia('siguiente')">Día Siguiente →</button>
  <input type="hidden" id="fecha-actual" value="{{fecha}}">
</div>

<div id="calendar"></div>

<!-- Modal para crear/editar -->
<div id="form-modal">
  <div id="form-header">
    <button onclick="mostrarFormulario('cita')">Crear Cita</button>
    <button onclick="mostrarFormulario('descanso')">Descansar</button>
  </div>
  <div id="form-body"></div>
  <button onclick="cerrarModal()">Cancelar</button>
</div>

<script>
  let calendar;

  document.addEventListener('DOMContentLoaded', function () {
    const calendarEl = document.getElementById('calendar');
    const fechaActual = document.getElementById('fecha-actual').value;

    calendar = new FullCalendar.Calendar(calendarEl, {
      initialView: 'timeGridDay',
      initialDate: fechaActual,
      slotMinTime: '08:00:00',
      slotMaxTime: '22:00:00',
      allDaySlot: false,
      slotDuration: '00:10:00',
      slotLabelInterval: '00:30:00',
      nowIndicator: true,
      expandRows: true,
      selectable: true,
      select: function(info) {
        abrirModal(info.startStr);
      },
      events: '/horario/eventos?fecha=' + fechaActual,

      eventDidMount: function(info) {
        const el = info.el;
        const event = info.event;

        const max = event.extendedProps.maxOverlap || 1;

        const calendarStartHour = 8;
        const start = new Date(info.event.start);
        const end = new Date(info.event.end);

        const startMinutes = (start.getHours() * 60 + start.getMinutes()) - (calendarStartHour * 60);
        const endMinutes = (end.getHours() * 60 + end.getMinutes()) - (calendarStartHour * 60);
        const durationMinutes = endMinutes - startMinutes;

        const widthPercent = 100 / max;
        const leftPercent = 0;

        const height = durationMinutes * 2.4;

        el.style.position = 'absolute';
        el.style.left = `${leftPercent}%`;
        el.style.width = `${widthPercent}%`;
        el.style.height = `${height}px`;
        el.style.marginRight = '5px';
        el.style.marginLeft = '5px';

        const tooltip = `${event.extendedProps.cliente} - ${event.extendedProps.servicio}`;
        el.setAttribute('title', tooltip);
      },

      eventClick: function(info) {
        abrirModal(info.event.startStr, info.event.extendedProps, info.event.id);
      }
    });

    calendar.render();
  });

  async function abrirModal(startStr, datos = null, citaId = null) {
    const modal = document.getElementById('form-modal');
    modal.style.display = 'block';

    const datosFormulario = await fetch('/horario/datos-formulario').then(res => res.json());
    const clientesOptions = datosFormulario.clientes
      .map(c => `<option value="${c.id}">${c.nombre} ${c.apellidos}</option>`)
      .join('');
    const serviciosOptions = datosFormulario.servicios.map(s => `<option value="${s.id}">${s.nombre}</option>`).join('');

    window.formStart = startStr;
    window.formDatos = datos;
    window.formCitaId = citaId;
    window.datosFormulario = datosFormulario;

    console.log('citaId en abrirModal:', citaId);
    console.log('Estado de la cita:', datos?.estado);

    const tipoFormulario = datos && datos.estado === 'descanso' ? 'descanso' : (datos ? 'editar' : 'cita');
    mostrarFormulario(tipoFormulario, clientesOptions, serviciosOptions);
  }

  function cerrarModal() {
    document.getElementById('form-modal').style.display = 'none';
  }

  function mostrarFormulario(tipo, clientesOptions = '', serviciosOptions = '') {
    const startTime = new Date(window.formStart).toTimeString().slice(0, 5);
    let endTime;

    if ((tipo === 'editar' || tipo === 'descanso') && window.formDatos) {
      endTime = window.formDatos.horaFin || '';
    } else {
      endTime = new Date(new Date(window.formStart).getTime() + 30 * 60000).toTimeString().slice(0, 5);
    }

    let formHtml = '';
    if (tipo === 'cita' || tipo === 'editar') {
      const datos = window.formDatos || {};
      formHtml = `
        <form onsubmit="crearOEditarCita(event)">
          <label>Hora Inicio: <input type="time" name="hora_ini" value="${datos.horaIni || startTime}"></label><br>
          <label>Hora Fin: <input type="time" name="hora_fin" value="${endTime}"></label><br>
          <label>Cliente:
            <select name="cliente_id">
              <option value="">Seleccionar cliente</option>
              ${clientesOptions}
            </select>
          </label><br>
          <label>Servicio:
            <select name="servicio_id">
              <option value="">Seleccionar servicio</option>
              ${serviciosOptions}
            </select>
          </label><br>
          <button type="submit">${tipo === 'editar' ? 'Editar' : 'Crear'}</button>
          ${window.formCitaId ? '<button type="button" class="delete-button" onclick="borrarCita()">Borrar</button>' : ''}
        </form>
      `;

      if (tipo === 'editar') {
        setTimeout(() => {
          const clienteSelect = document.querySelector('select[name="cliente_id"]');
          const servicioSelect = document.querySelector('select[name="servicio_id"]');

          const clienteNombre = datos.cliente?.trim().toLowerCase() || '';
          let clienteEncontrado;

          if (clienteNombre && clienteNombre !== 'sin cliente') {
            clienteEncontrado = window.datosFormulario.clientes.find(c => {
              const nombreCompleto = `${c.nombre} ${c.apellidos}`.trim().toLowerCase();
              return nombreCompleto === clienteNombre;
            });

            if (!clienteEncontrado) {
              clienteEncontrado = window.datosFormulario.clientes.find(c => {
                const nombre = c.nombre?.trim().toLowerCase() || '';
                return nombre === clienteNombre;
              });
            }
          }

          if (clienteEncontrado) {
            clienteSelect.value = clienteEncontrado.id;
          } else if (clienteNombre) {
            console.warn('Cliente no encontrado:', datos.cliente, 'Clientes disponibles:', window.datosFormulario.clientes.map(c => `${c.nombre} ${c.apellidos}`));
          }

          const servicioEncontrado = window.datosFormulario.servicios.find(s => s.nombre === datos.servicio);
          if (servicioEncontrado) {
            servicioSelect.value = servicioEncontrado.id;
          } else if (datos.servicio && datos.servicio !== 'Sin servicio') {
            console.warn('Servicio no encontrado:', datos.servicio, 'Servicios disponibles:', window.datosFormulario.servicios);
          }
        }, 0);
      }
    } else if (tipo === 'descanso') {
      const datos = window.formDatos || {};
      formHtml = `
        <form onsubmit="crearDescanso(event)">
          <label>Hora Inicio: <input type="time" name="hora_ini" value="${datos.horaIni || startTime}"></label><br>
          <label>Hora Fin: <input type="time" name="hora_fin" value="${endTime}"></label><br>
          <button type="submit">${window.formCitaId ? 'Editar Descanso' : 'Crear Descanso'}</button>
          ${window.formCitaId ? '<button type="button" class="delete-button" onclick="borrarCita()">Borrar</button>' : ''}
        </form>
      `;
    }

    document.getElementById('form-body').innerHTML = formHtml;
  }

  async function crearOEditarCita(e) {
    e.preventDefault();
    const form = e.target;
    const data = {
      cliente_id: form.cliente_id.value,
      servicio_id: form.servicio_id.value,
      hora_ini: form.hora_ini.value,
      hora_fin: form.hora_fin.value,
      fecha: document.getElementById('fecha-actual').value
    };

    console.log('window.formCitaId en crearOEditarCita:', window.formCitaId);

    if (!window.formCitaId) {
      console.error('Error: No se proporcionó un ID de cita para editar. Creando una nueva cita.');
    }

    const url = window.formCitaId ? `/api/editar-cita/${window.formCitaId}` : '/api/crear-cita';
    await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });

    cerrarModal();
    calendar.refetchEvents();
  }

  async function crearDescanso(e) {
    e.preventDefault();
    const form = e.target;
    const data = {
      fecha: document.getElementById('fecha-actual').value,
      hora_ini: form.hora_ini.value,
      hora_fin: form.hora_fin.value
    };

    const url = window.formCitaId ? `/api/editar-cita/${window.formCitaId}` : '/api/crear-descanso';
    await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });

    cerrarModal();
    calendar.refetchEvents();
  }

  async function borrarCita() {
    if (!window.formCitaId) {
      alert('Error: No se proporcionó un ID de cita para borrar.');
      return;
    }

    if (!confirm('¿Estás seguro de que deseas borrar esta cita?')) {
      return;
    }

    try {
      const response = await fetch(`/api/borrar-cita/${window.formCitaId}`, {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' }
      });

      if (!response.ok) {
        throw new Error('Error al borrar la cita');
      }

      cerrarModal();
      calendar.refetchEvents();
    } catch (error) {
      console.error('Error al borrar la cita:', error);
      alert('No se pudo borrar la cita. Por favor, intenta de nuevo.');
    }
  }

  function cambiarDia(direccion) {
    const fechaInput = document.getElementById('fecha-actual');
    let fecha = new Date(fechaInput.value);

    if (direccion === 'anterior') {
      fecha.setDate(fecha.getDate() - 1);
    } else {
      fecha.setDate(fecha.getDate() + 1);
    }

    const nuevaFecha = fecha.toISOString().split('T')[0];
    window.location.href = `/horario?fecha=${nuevaFecha}`;
  }
</script>