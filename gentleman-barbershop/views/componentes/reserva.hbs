    <!-- Testimonials Section -->
    <section class="testimonials-section">
        <div class="container">
            <h2 class="section-title">Testimonios</h2>
            <p class="section-description">Escucha lo que dicen nuestros clientes</p>
            
            <div class="testimonials-grid">
                <div class="testimonial-card">
                    <p class="testimonial-text">"¡El mejor corte que he tenido! Juan fue increíblemente profesional."</p>
                    <p class="testimonial-author">— Carlos M.</p>
                </div>
                <div class="testimonial-card">
                    <p class="testimonial-text">"María transformó mi look con la micropigmentación. ¡Recomendado al 100%!"</p>
                    <p class="testimonial-author">— Laura G.</p>
                </div>
                <div class="testimonial-card">
                    <p class="testimonial-text">"Ambiente genial y servicio rápido. Volveré pronto."</p>
                    <p class="testimonial-author">— Pedro L.</p>
                </div>
