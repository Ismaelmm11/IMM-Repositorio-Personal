<!-- Booking Section -->
    <section class="booking-section">
        <div class="container">
            <h2 class="section-title2">Reserva tu cita</h2>
            <p class="section-description">Selecciona tu servicio, barbero y horario preferido</p>
            
            <!-- Progress Steps -->
            <div class="progress-steps">
                <div class="progress-step" data-step="1">
                    <div id="1" class="step-number active"><span>1</span></div>
                    <span class="step-label">Servicio</span>
                </div>
                <div class="progress-step" data-step="2">
                    <div id="2" class="step-number"><span>2</span></div>
                    <span class="step-label">Datos</span>
                </div>
            </div>
            
            <!-- Booking Form - Step 1 -->
            <div id="step-1" class="booking-step active">
                <div class="step-container">
                    <h3 class="step-title">Selecciona tu servicio</h3>
                    
                    <div class="form-group">
                        <label class="form-label">Tipo de servicio</label>
                        <select id="service-type" class="form-select">
                            <option value="">Selecciona un servicio</option>
                            <option value="haircut" data-duration="30" data-price="25">Corte de cabello - 30 min - €25</option>
                            <option value="micropigmentation" data-duration="60" data-price="60">Micropigmentación - 60 min - €60</option>
                            <option value="tattoo" data-duration="90" data-price="90">Tatuaje - 90 min - €90+</option>
                        </select>
                    </div>
                    
                    <div class="form-group">
                        <label class="form-label">Barbero/Profesional</label>
                        <div class="barber-selection">
                            <!-- Barber 1 -->
                            <div class="barber-card" data-barber="juan">
                                <img src="https://randomuser.me/api/portraits/men/32.jpg" alt="Juan">
                                <h4 class="barber-name">Juan</h4>
                            </div>
                            
                            <!-- Barber 2 -->
                            <div class="barber-card" data-barber="maria">
                                <img src="https://randomuser.me/api/portraits/women/44.jpg" alt="María">
                                <h4 class="barber-name">María</h4>
                            </div>
                            
                            <!-- Barber 3 -->
                            <div class="barber-card" data-barber="pedro">
                                <img src="https://randomuser.me/api/portraits/men/75.jpg" alt="Pedro">
                                <h4 class="barber-name">Pedro</h4>
                            </div>
                        </div>
                    </div>
                    
                    <div class="price-summary">
                        <div>
                            <p class="price-label">Precio estimado:</p>
                            <p id="estimated-price" class="price-value">€0</p>
                        </div>
                        <button id="next-step-1" class="btn" disabled><span>Siguiente</span></button>
                    </div>
                </div>
            </div>
            
            <!-- Booking Form - Step 2 -->
            <div id="step-2" class="booking-step">
                <div class="step-container step-container-large">
                    <h3 class="step-title">Completa tus datos</h3>
                    
                    <div class="booking-details">
                        <!-- Left Column - Personal Info -->
                        <div class="booking-form">
                            <div class="form-group">
                                <label for="full-name" class="form-label">Nombre completo <span style="color: var(--error-red);">*</span></label>
                                <input type="text" id="full-name" class="form-input" placeholder="Ej: Juan Pérez">
                                <p id="name-error" class="error-message">Por favor ingresa un nombre válido (solo letras y espacios)</p>
                            </div>
                            
                            <div class="form-group">
                                <label for="birth-date" class="form-label">Fecha de nacimiento <span style="color: var(--error-red);">*</span></label>
                                <input type="date" id="birth-date" class="form-input">
                                <p id="birth-error" class="error-message">Debes ser mayor de edad para reservar</p>
                            </div>
                            
                            <div class="form-group">
                                <label for="phone" class="form-label">Teléfono <span style="color: var(--error-red);">*</span></label>
                                <div class="phone-input-group">
                                    <select class="form-select phone-code" id="phone-code">
                                        <option value="+34">+34</option>
                                        <option value="+1">+1</option>
                                        <option value="+44">+44</option>
                                        <option value="+39">+39</option>
                                    </select>
                                    <input type="tel" id="phone" class="form-input phone-number" placeholder="Ej: 612 345 678">
                                </div>
                                <p id="phone-error" class="error-message">Por favor ingresa un teléfono válido</p>
                            </div>
                            
                            <div class="form-group">
                                <label for="email" class="form-label">Email <span style="color: var(--error-red);">*</span></label>
                                <input type="email" id="email" class="form-input" placeholder="Ej: juan@example.com">
                                <p id="email-error" class="error-message">Por favor ingresa un email válido</p>
                            </div>
                            
                            <div class="form-group">
                                <label for="comments" class="form-label">Comentarios adicionales (opcional)</label>
                                <textarea id="comments" class="form-textarea" rows="3" maxlength="200" placeholder="Algo que debamos saber..."></textarea>
                                <p class="char-counter"><span id="chars-left">200</span> caracteres restantes</p>
                            </div>
                            
                            <div class="form-group">
                                <div class="checkbox-group">
                                    <input id="privacy-policy" type="checkbox" class="checkbox-input">
                                    <div>
                                        <label for="privacy-policy" class="checkbox-label">Acepto la política de privacidad <span style="color: var(--error-red);">*</span></label>
                                        <p id="privacy-error" class="error-message">Debes aceptar la política de privacidad</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Right Column - Calendar -->
                        <div class="booking-calendar">
                            <div class="form-group">
                                <label class="form-label">Selecciona fecha y hora</label>
                                
                                <!-- Calendar Navigation -->
                                <div class="calendar-navigation">
                                    <button id="prev-month" class="calendar-nav-button">
                                        <i class="fas fa-chevron-left"></i>
                                    </button>
                                    <h4 id="current-month" class="calendar-month">Junio 2023</h4>
                                    <button id="next-month" class="calendar-nav-button">
                                        <i class="fas fa-chevron-right"></i>
                                    </button>
                                </div>
                                
                                <!-- Calendar Grid -->
                                <div class="calendar-grid">
                                    <div class="calendar-day-header">L</div>
                                    <div class="calendar-day-header">M</div>
                                    <div class="calendar-day-header">X</div>
                                    <div class="calendar-day-header">J</div>
                                    <div class="calendar-day-header">V</div>
                                    <div class="calendar-day-header">S</div>
                                    <div class="calendar-day-header">D</div>
                                </div>
                                
                                <!-- Time Slots -->
                                <div class="form-group">
                                    <h5 class="time-slots-label">Horas disponibles:</h5>
                                    <div id="time-slots" class="time-slots">
                                        <!-- Time slots will be inserted here by JavaScript -->
                                    </div>
                                </div>
                                
                                <!-- Selected Date & Time -->
                                <div class="selected-datetime-container">
                                    <p class="selected-datetime-label">Seleccionado:</p>
                                    <p id="selected-datetime" class="selected-datetime-value">Por favor selecciona una fecha y hora</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="modal-actions">
                        <button id="prev-step-2" class="btn"><span>Anterior</span></button>
                        <button id="next-step-2" class="btn" disabled><span>Confirmar reservaz</span></button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Why Choose Us Section -->
    <section class="why-choose-us">
        <div class="container">
            <h2 class="section-title">Por qué nos eliges</h2>
            <p class="section-description">Descubre lo que nos hace diferentes</p>
            
            <div class="why-choose-grid">
                <div class="why-choose-card">
                    <i class="fas fa-scissors"></i>
                    <h3 class="why-choose-card-title">Expertos en cortes</h3>
                    <p class="why-choose-card-description">Nuestros barberos están altamente capacitados para ofrecerte los mejores cortes.</p>
                </div>
                <div class="why-choose-card">
                    <i class="fas fa-user-tie"></i>
                    <h3 class="why-choose-card-title">Estilo personalizado</h3>
                    <p class="why-choose-card-description">Adaptamos cada servicio a tu estilo único y preferencias.</p>
                </div>
                <div class="why-choose-card">
                    <i class="fas fa-clock"></i>
                    <h3 class="why-choose-card-title">Puntualidad</h3>
